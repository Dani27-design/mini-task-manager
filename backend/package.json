{
  "name": "mini-task-manager-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "node --test --test-concurrency=1 -r ts-node/register \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:unit": "node --test -r ts-node/register \"src/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 -r ts-node/register \"test/integration/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 -r ts-node/register \"test/e2e/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
